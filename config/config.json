{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "banner-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/banner/BannerWebPart.js",
          "manifest": "./src/webparts/banner/BannerWebPart.manifest.json"
        }
      ]
    },
    "top-nav-footer-application-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/topNavFooter/TopNavFooterApplicationCustomizer.js",
          "manifest": "./src/extensions/topNavFooter/TopNavFooterApplicationCustomizer.manifest.json"
        }
      ]
    },
    "dpt-page-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/dptPage/DptPageWebPart.js",
          "manifest": "./src/webparts/dptPage/DptPageWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "BannerWebPartStrings": "lib/webparts/banner/loc/{locale}.js",
    "TopNavFooterApplicationCustomizerStrings": "lib/extensions/topNavFooter/loc/{locale}.js",
    "DptPageWebPartStrings": "lib/webparts/dptPage/loc/{locale}.js"
  }
}
